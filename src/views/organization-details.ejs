<%- include('./partials/header') %>

<main>
    <h1><%= title %></h1>

    <div>
        <img src="/images/<%= orgDetails[0].logo_file_name %>" alt="<%= orgDetails[0].name %>">
        <p><%= orgDetails[0].description %></p>
        <p><%= orgDetails[0].contact_email %></p>
    </div>

    <div>
        <% projects.forEach(project => { %>
            <li>
                <h2><%= project.title %></h2>
                <p><%= project.description %></p>
                <p>Location: <%= project.location %></p>
                <p>Date: <%= project.date %></p>
            </li>

       <% }) %>
    </div>

</main>


<%- include('./partials/footer') %>
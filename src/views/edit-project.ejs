<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Project Name</label>
      <input
        type="text"
        id="title"
        name="title"
        required
        maxlength="150"
        value="<%= projectDetails.title %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="500"
      ><%= projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">location</label>
      <input
        type="text"
        id="location"
        name="location"
        required
        value="<%= projectDetails.location %>"
      />
    </div>

    <div class="form-group">
      <label for="location">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        required
        value="<%= projectDetails.date.toISOString().split('T')[0] %>"
      />
    </div>

    <div class="form-group">
      <label for="organization">Organization</label>
      <select name="orgId" id="orgId" required>
        <% organizations.forEach(org => { %>
            <option value="<%= org.org_id %>" <%= org.org_id === projectDetails.org_id? 'selected' : '' %> ><%= org.name %></option>
        <% }) %>
      </select>
    </div>

    <button type="submit">Update Project</button>
  </form>

</main>
<%- include('partials/footer') %>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <p>Here are a few of our partner organizations:</p>
    <h2>Upcoming Service Projects</h2>
    <ul>
        
        <% projects.forEach(
            project => { %>
                <a href="./project/<%= project.project_id %>">
                    <li><%= project.title %> - <%= project.name %></li>
                </a>
            <% }
        ); %>
    </ul>
</main>
<%- include('partials/footer') %>
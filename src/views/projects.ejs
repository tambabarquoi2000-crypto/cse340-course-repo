<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <p>Here are a few of our partner organizations:</p>
    <h2>Upcoming Service Projects</h2>
    <ul>
        
        <% projects.forEach(
            project => { %>
                <li><a href="project/<%= project.project_id %>"><%= project.title %></a> - <a href="/organization/<%= project.org_id %>"><%= project.name %></a></li>
            <% }
        ); %>
    </ul>
</main>
<%- include('partials/footer') %>

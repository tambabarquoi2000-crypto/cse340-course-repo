<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/edit-organization/<%= result[0].org_id %>" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="150"
        value = "<%= result[0].name %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="150"
        
      ><%= result[0].description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        required
        value = <%= result[0].contact_email %>
      />
    </div>

    <div class="form-group">
      <label for="fileName">File Name</label>
      <input
        type="text"
        id="fileName"
        name="fileName"
        required
        value = <%= result[0].logo_file_name %>
      />
    </div>

    <button type="submit">Update Organization</button>
  </form>

</main>
<%- include('partials/footer') %>